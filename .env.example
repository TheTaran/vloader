# Copy to .env; generate ADMIN_PASSWORD with: openssl rand -hex 24
APP_URL=http://localhost:8090
BIND_ADDRESS=127.0.0.1
PORT=8090
# Used only by compose-production-template.yml. Use 0.2 for the current minor
# series or an exact release such as 0.2.3.
VLOADER_VERSION=0.2
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set false to offer OIDC-only access. OIDC must then be configured.
LOCAL_AUTH_ENABLED=true
# Emby connection and download-source settings are configured in the web UI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional comma-separated stable OIDC sub values allowed to sign in.
OIDC_ALLOWED_SUBJECTS=
# Claim in the verified ID token containing group names (Pocket ID: groups).
OIDC_GROUPS_CLAIM=groups
# Comma-separated groups allowed to sign in as regular users.
OIDC_ALLOWED_GROUPS=
# Comma-separated groups granted administrator access.
OIDC_ADMIN_GROUPS=
# Optional comma-separated OIDC subject IDs that receive administrator access.
OIDC_ADMIN_SUBJECTS=
# NFS/SMB are activated in compose.yml; examples: compose-template.yml
NFS_SERVER=
NFS_EXPORT=
SMB_SERVER=
SMB_SHARE=
# Local NAS account: smbuser
# Domain account: DOMAIN\\smbuser (the entrypoint splits domain and username for mount.cifs)
SMB_CREDENTIAL_USERNAME=
SMB_CREDENTIAL_PASSWORD=
