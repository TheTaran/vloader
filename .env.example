# Copy to .env; generate ADMIN_PASSWORD with: openssl rand -hex 24
APP_URL=http://localhost:8090
BIND_ADDRESS=127.0.0.1
PORT=8090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set false to offer OIDC-only access. OIDC must then be configured.
LOCAL_AUTH_ENABLED=true
DATA_DIR=/data
EMBY_URL=
EMBY_API_KEY=
# Source mode and source path are configured in Settings → Connection.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated stable OIDC sub values. All others are denied.
OIDC_ALLOWED_SUBJECTS=
# Comma-separated OIDC subject IDs that receive administrator access.
OIDC_ADMIN_SUBJECTS=
# NFS/SMB are activated in compose.yml; examples: compose-template.yml
NFS_SERVER=
NFS_EXPORT=
SMB_SERVER=
SMB_SHARE=
# Local NAS account: smbuser
# Domain account: DOMAIN\\smbuser (the entrypoint splits domain and username for mount.cifs)
SMB_CREDENTIAL_USERNAME=
SMB_CREDENTIAL_PASSWORD=
